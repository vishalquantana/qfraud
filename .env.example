# Database
DATABASE_URL="postgresql://user:password@localhost:5432/quantana_shield?schema=public"

# NextAuth
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Email provider ("smtp" or "sendgrid")
EMAIL_PROVIDER="smtp"

# SMTP settings (when EMAIL_PROVIDER="smtp")
SMTP_HOST="localhost"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""

# SendGrid settings (when EMAIL_PROVIDER="sendgrid")
SENDGRID_API_KEY=""

# Default sender email (overridden by tenant white-label config)
EMAIL_FROM_ADDRESS="noreply@quantanashield.com"

# Portal
DEFAULT_TENANT_SLUG="test-mga"

# AWS S3
AWS_REGION="us-east-1"
S3_BUCKET="quantana-shield-documents"
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
