// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────

enum Role {
  ADMIN
  UNDERWRITER
  SENIOR_UNDERWRITER
  SIU_INVESTIGATOR
  COMPLIANCE_OFFICER
  BROKER
}

enum SubmissionStatus {
  PROCESSING
  UNDER_REVIEW
  APPROVED
  DECLINED
  INFO_NEEDED
  REFERRED_TO_SIU
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  CLEAN
}

enum Channel {
  PORTAL
  EMAIL
  API
}

enum DocumentType {
  ACORD_125
  ACORD_130
  ACORD_140
  LOSS_RUN
  FINANCIAL_STATEMENT
  COI
  ENTITY_DOC
  INSPECTION_PHOTO
  MVR
  SOV
  SURPLUS_LINES
  PROFESSIONAL_LICENSE
  ENVIRONMENTAL_REPORT
  PAYROLL_TAX
  BROKER_SUBMISSION
  FLEET_SCHEDULE
  UNKNOWN
}

enum DocumentStatus {
  UPLOADED
  CLASSIFYING
  EXTRACTING
  ANALYZED
  ERROR
}

enum SIUCaseStatus {
  OPEN
  INVESTIGATING
  EVIDENCE_GATHERED
  CONFIRMED_FRAUD
  FALSE_POSITIVE
  INCONCLUSIVE
}

enum FraudIndicatorCategory {
  CROSS_DOC
  FORENSIC
  STATISTICAL
  TEMPORAL
  RATIO
  ENTITY_INTEL
  VISUAL_AI
  NLP
  API_VERIFY
  RULES
}

// ─── Tenant ──────────────────────────────────────────────

model Tenant {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  domain         String?
  logoUrl        String?
  primaryColor   String?
  secondaryColor String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users            User[]
  submissions      Submission[]
  documents        Document[]
  fraudIndicators  FraudIndicator[]
  auditLogs        AuditLog[]
  thresholdConfigs ThresholdConfig[]
  siuCases         SIUCase[]
  whiteLabelConfig WhiteLabelConfig?
  apiKeys              ApiKey[]
  webhookSubscriptions WebhookSubscription[]
  complianceConfig     ComplianceConfig?

  @@map("tenants")
}

// ─── User ────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  tenantId     String
  email        String
  name         String
  role         Role
  passwordHash String
  mfaSecret    String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  tenant               Tenant           @relation(fields: [tenantId], references: [id])
  submittedSubmissions Submission[]     @relation("Submitter")
  assignedSubmissions  Submission[]     @relation("AssignedUnderwriter")
  indicatorOverrides   FraudIndicator[] @relation("IndicatorOverrides")
  auditLogs            AuditLog[]       @relation("AuditLogUser")
  assignedSIUCases     SIUCase[]        @relation("SIUCaseAssignee")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

// ─── Submission ────────────────────────────────────────────

model Submission {
  id                    String           @id @default(cuid())
  tenantId              String
  submitterId           String
  insuredName           String
  lineOfBusiness        String?
  status                SubmissionStatus @default(PROCESSING)
  riskScore             Int?
  severity              Severity?
  channel               Channel          @default(PORTAL)
  assignedUnderwriterId String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  tenant              Tenant   @relation(fields: [tenantId], references: [id])
  submitter           User     @relation("Submitter", fields: [submitterId], references: [id])
  assignedUnderwriter User?            @relation("AssignedUnderwriter", fields: [assignedUnderwriterId], references: [id])
  documents           Document[]
  fraudIndicators     FraudIndicator[]
  auditLogs           AuditLog[]
  siuCases            SIUCase[]

  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
  @@map("submissions")
}

// ─── Document ──────────────────────────────────────────────

model Document {
  id                       String        @id @default(cuid())
  submissionId             String
  tenantId                 String
  fileName                 String
  fileType                 String
  fileSize                 Int
  s3Key                    String
  documentType             DocumentType  @default(UNKNOWN)
  classificationConfidence Float?
  extractedData            Json?
  status                   DocumentStatus @default(UPLOADED)
  createdAt                DateTime      @default(now())

  submission      Submission      @relation(fields: [submissionId], references: [id])
  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  fraudIndicators FraudIndicator[]

  @@index([tenantId])
  @@index([submissionId])
  @@index([status])
  @@index([createdAt])
  @@map("documents")
}

// ─── FraudIndicator ──────────────────────────────────────

model FraudIndicator {
  id                    String                 @id @default(cuid())
  submissionId          String
  tenantId              String
  documentId            String?
  category              FraudIndicatorCategory
  indicatorName         String
  description           String
  severity              Severity
  evidence              Json
  confidence            Float
  recommendedAction     String?
  isOverridden          Boolean                @default(false)
  overriddenById        String?
  overrideJustification String?
  createdAt             DateTime               @default(now())

  submission   Submission @relation(fields: [submissionId], references: [id])
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  document     Document?  @relation(fields: [documentId], references: [id])
  overriddenBy User?      @relation("IndicatorOverrides", fields: [overriddenById], references: [id])

  @@index([tenantId])
  @@index([submissionId])
  @@index([category])
  @@index([severity])
  @@map("fraud_indicators")
}

// ─── AuditLog ────────────────────────────────────────────

model AuditLog {
  id           String   @id @default(cuid())
  tenantId     String
  submissionId String?
  userId       String?
  action       String
  details      Json
  ipAddress    String?
  createdAt    DateTime @default(now())

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  submission Submission? @relation(fields: [submissionId], references: [id])
  user       User?       @relation("AuditLogUser", fields: [userId], references: [id])

  @@index([tenantId])
  @@index([submissionId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── ThresholdConfig ─────────────────────────────────────

model ThresholdConfig {
  id                   String   @id @default(cuid())
  tenantId             String
  lineOfBusiness       String?
  autoApproveBelow     Int      @default(20)
  autoEscalateAbove    Int      @default(70)
  siuReferralOnCritical Boolean @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("threshold_configs")
}

// ─── SIUCase ────────────────────────────────────────────

model SIUCase {
  id           String        @id @default(cuid())
  tenantId     String
  submissionId String
  status       SIUCaseStatus @default(OPEN)
  assignedToId String
  notes        Json          @default("[]")
  evidence     Json          @default("[]")
  resolution   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  submission Submission @relation(fields: [submissionId], references: [id])
  assignedTo User       @relation("SIUCaseAssignee", fields: [assignedToId], references: [id])

  @@index([tenantId])
  @@index([submissionId])
  @@index([status])
  @@map("siu_cases")
}

// ─── ApiKey ─────────────────────────────────────────────

model ApiKey {
  id          String   @id @default(cuid())
  tenantId    String
  key         String   @unique
  name        String
  permissions Json     @default("[]")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([key])
  @@map("api_keys")
}

// ─── WebhookSubscription ────────────────────────────────

model WebhookSubscription {
  id        String   @id @default(cuid())
  tenantId  String
  url       String
  events    Json     @default("[]")
  secret    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("webhook_subscriptions")
}

// ─── WhiteLabelConfig ───────────────────────────────────

model WhiteLabelConfig {
  id                String   @id @default(cuid())
  tenantId          String   @unique
  logoUrl           String?
  primaryColor      String   @default("#1e40af")
  secondaryColor    String   @default("#3b82f6")
  accentColor       String   @default("#f59e0b")
  customDomain      String?
  customEmailDomain String?
  termsUrl          String?
  privacyUrl        String?
  footerText        String?
  supportEmail      String?
  supportPhone      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("white_label_configs")
}

// ─── ComplianceConfig ─────────────────────────────────────

model ComplianceConfig {
  id              String   @id @default(cuid())
  tenantId        String   @unique
  retentionYears  Int      @default(5)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("compliance_configs")
}
