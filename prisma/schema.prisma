// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────

enum Role {
  ADMIN
  UNDERWRITER
  SENIOR_UNDERWRITER
  SIU_INVESTIGATOR
  COMPLIANCE_OFFICER
  BROKER
}

enum SubmissionStatus {
  PROCESSING
  UNDER_REVIEW
  APPROVED
  DECLINED
  INFO_NEEDED
  REFERRED_TO_SIU
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  CLEAN
}

enum Channel {
  PORTAL
  EMAIL
  API
}

enum DocumentType {
  ACORD_125
  ACORD_130
  ACORD_140
  LOSS_RUN
  FINANCIAL_STATEMENT
  COI
  ENTITY_DOC
  INSPECTION_PHOTO
  MVR
  SOV
  SURPLUS_LINES
  PROFESSIONAL_LICENSE
  ENVIRONMENTAL_REPORT
  PAYROLL_TAX
  BROKER_SUBMISSION
  FLEET_SCHEDULE
  UNKNOWN
}

enum DocumentStatus {
  UPLOADED
  CLASSIFYING
  EXTRACTING
  ANALYZED
  ERROR
}

// ─── Tenant ──────────────────────────────────────────────

model Tenant {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  domain         String?
  logoUrl        String?
  primaryColor   String?
  secondaryColor String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users       User[]
  submissions Submission[]
  documents   Document[]

  @@map("tenants")
}

// ─── User ────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  tenantId     String
  email        String
  name         String
  role         Role
  passwordHash String
  mfaSecret    String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  tenant               Tenant       @relation(fields: [tenantId], references: [id])
  submittedSubmissions Submission[] @relation("Submitter")
  assignedSubmissions  Submission[] @relation("AssignedUnderwriter")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

// ─── Submission ────────────────────────────────────────────

model Submission {
  id                    String           @id @default(cuid())
  tenantId              String
  submitterId           String
  insuredName           String
  lineOfBusiness        String?
  status                SubmissionStatus @default(PROCESSING)
  riskScore             Int?
  severity              Severity?
  channel               Channel          @default(PORTAL)
  assignedUnderwriterId String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  tenant              Tenant   @relation(fields: [tenantId], references: [id])
  submitter           User     @relation("Submitter", fields: [submitterId], references: [id])
  assignedUnderwriter User?    @relation("AssignedUnderwriter", fields: [assignedUnderwriterId], references: [id])
  documents           Document[]

  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
  @@map("submissions")
}

// ─── Document ──────────────────────────────────────────────

model Document {
  id                       String        @id @default(cuid())
  submissionId             String
  tenantId                 String
  fileName                 String
  fileType                 String
  fileSize                 Int
  s3Key                    String
  documentType             DocumentType  @default(UNKNOWN)
  classificationConfidence Float?
  extractedData            Json?
  status                   DocumentStatus @default(UPLOADED)
  createdAt                DateTime      @default(now())

  submission Submission @relation(fields: [submissionId], references: [id])
  tenant     Tenant     @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([submissionId])
  @@index([status])
  @@index([createdAt])
  @@map("documents")
}
